# ---------- API Key（推荐）----------
# 系统环境变量 interview = DeepSeek API Key

# ---------- 全局默认 ----------
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=15000
LLM_TIMEOUT=180
LLM_MAX_RETRIES=3
LLM_THINKING=false
LLM_REASONING_EFFORT=high

# ---------- 分阶段模型（可选覆盖）----------
# FR2 简历摘要
# LLM_RESUME_MODEL=deepseek-v4-pro
# LLM_RESUME_TEMPERATURE=0.2
# LLM_RESUME_MAX_TOKENS=15000
# LLM_RESUME_THINKING=false

# FR3 对话整理
# LLM_DIALOGUE_MODEL=deepseek-v4-pro
# LLM_DIALOGUE_TEMPERATURE=0.2
# LLM_DIALOGUE_MAX_TOKENS=15000
# LLM_DIALOGUE_THINKING=false

# FR5 逐题分析（默认已下调 max_tokens；可按步覆盖）
# LLM_ANALYSIS_MODEL=deepseek-v4-pro
# LLM_ANALYSIS_TEMPERATURE=0.2
# LLM_ANALYSIS_MAX_TOKENS=4096
# LLM_ANALYSIS_STEP1_MAX_TOKENS=1024
# LLM_ANALYSIS_STEP2_MAX_TOKENS=4096
# LLM_ANALYSIS_THINKING=false

QA_ANALYSIS_CONCURRENCY=3
PERSIST_INTERMEDIATE=true
OUTPUT_DIR=output
SESSIONS_DIR=data/sessions

LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
